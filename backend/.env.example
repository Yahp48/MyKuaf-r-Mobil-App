# .env olarak kopyala. Gerçek değerler asla git'e girmez.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# docker-compose.yml ile uyumlu yerel veritabanı (testler otomatik olarak mykuafor_test'i kullanır)
DATABASE_URL=postgresql://mykuafor:mykuafor_dev@localhost:5432/mykuafor?schema=public

# En az 32 karakter, birbirinden farklı rastgele değerler:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Sunucunun dışarıdan erişilen adresi (ödeme sayfası bağlantıları bununla üretilir)
PUBLIC_BASE_URL=http://localhost:5000
# Nginx / load balancer arkasındaysa vekil sayısı (gerçek istemci IP'si için)
TRUST_PROXY_HOPS=0
# Yalnızca web istemcileri için, virgülle ayrılmış (mobil uygulama gerekmez)
CORS_ORIGINS=

# mock = test ödeme sayfası (production'da yasak) | iyzico
PAYMENT_PROVIDER=mock
# PayTR (PAYMENT_PROVIDER=paytr): mağaza paneli → BİLGİ. Bildirim URL'si panelde
# https://<api-adresi>/api/payments/paytr/callback olarak tanımlanmalı. Test modu: 1 (production'da 0).
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
# Yalnızca yerel deneme: dış IP adresiniz (PayTR özel ağ IP'lerini kabul etmez)
PAYTR_DEV_PUBLIC_IP=

# Yapay zekâ saç modeli denemesi: none | ailabtools (https://www.ailabtools.com). Anahtar boşsa özellik gizlenir.
# Kullanıcı fotoğrafı sağlayıcıya (yurt dışı) gönderilir: uygulama açık rıza alır; sağlayıcı fotoğrafı saklamaz.
TRYON_AI_PROVIDER=none
AILABTOOLS_API_KEY=
TRYON_AI_DAILY_LIMIT=5
APP_DEEP_LINK_SCHEME=bibakim

# Google Directions API (yalnızca sunucuda; IP ile kısıtlanmalı)
GOOGLE_MAPS_SERVER_API_KEY=

# Şifre sıfırlama e-postaları (production'da zorunlu)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BiBakım <no-reply@bibakim.app>"

# Kuruş cinsinden: 2999 = 29,99 TL
SHIPPING_FEE_CENTS=2999
FREE_SHIPPING_THRESHOLD_CENTS=50000
WALLET_MIN_TOPUP_CENTS=5000
WALLET_MAX_TOPUP_CENTS=500000

# Platformu işleten şirket (faturayı kesen taraf). Uygulamada "Hakkında", KVKK metni ve panelin yasal
# sayfalarında gösterilir. Production'da unvan, adres, vergi no ve e-posta zorunludur.
COMPANY_LEGAL_NAME=
COMPANY_SHORT_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
COMPANY_MERSIS=
COMPANY_KEP=
# Platformun kendi iletişim adresi (ör. destek@bibakim.app); yasal sayfalarda ve KVKK başvurularında gösterilir.
# Production'da e-posta zorunlu. İşleten şirketin genel e-postası buraya yazılmaz.
SUPPORT_EMAIL=
SUPPORT_PHONE=
