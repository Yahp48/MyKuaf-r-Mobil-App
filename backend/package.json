{
  "name": "bakimca-backend",
  "version": "1.0.0",
  "description": "Bakımca mobil uygulaması REST API ve gerçek zamanlı sunucu",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "type": "module",
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "expo-server-sdk": "^8.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "effect": "^3.22.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
