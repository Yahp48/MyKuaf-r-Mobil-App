# Bu dosyayı .env olarak kopyalayıp değerleri doldur. .env asla GitHub'a gönderilmez.
# EXPO_PUBLIC_ ile başlayan değerler uygulama paketine gömülür: buraya GİZLİ anahtar koyma.

# Backend adresi. Geliştirmede boş bırakılırsa Expo'yu çalıştıran bilgisayarın IP'si kullanılır
# (telefon ve bilgisayar aynı ağda olmalı). Production derlemesinde ZORUNLU ve https olmalı.
EXPO_PUBLIC_API_URL=

# Android Maps SDK anahtarı (react-native-maps). Derleme sırasında app.config.js okur.
# Google Cloud'da "Android uygulamaları" ile kısıtlayın. Yol tarifi anahtarı backend/.env'dedir.
GOOGLE_MAPS_ANDROID_API_KEY=

# Destek ve iletişim bilgileri (Hakkında / Müşteri Hizmetleri ekranları). Boş bırakılan gösterilmez.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_HOURS=
EXPO_PUBLIC_WEBSITE_URL=
EXPO_PUBLIC_INSTAGRAM_URL=
